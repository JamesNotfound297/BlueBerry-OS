{
  "manifest_version": 3,
  "name": "BlueBerry OS",
  "version": "0.2.1",
  "description": "BlueBerry OS - 遵循 MD3 设计风格的浏览器起始页 - Blue blue berry",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon128.svg",
    "48": "icons/icon128.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://suggestqueries.google.com/*",
    "https://images.unsplash.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "BlueBerry OS"
  }
}
